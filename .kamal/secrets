# Secrets referenced from config/deploy.yml under registry/password and env/secret.
#
# This file IS committed, so it must never contain a raw credential — every line
# reads from the environment or a password manager. Kamal evaluates it on the
# machine running the deploy, not on the server.

# --- Container registry -----------------------------------------------------
# A Docker Hub access token, not your account password.
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

# --- Model providers --------------------------------------------------------
# Only the one matching the model selected in Settings is actually used, but
# both are passed so switching providers does not require a redeploy.
# Leave a provider's variable empty if you do not use it.
ANTHROPIC_API_KEY=$ANTHROPIC_API_KEY
OPENAI_API_KEY=$OPENAI_API_KEY

