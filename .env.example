# Copy to .env and fill in.

# One of these is required, matching the model you select in Settings.
# Claude models (claude-*) — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
# OpenAI models (gpt-*, o*) — https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...

# ---- Accounts and sign-in -------------------------------------------------
# There is no public signup. On first boot, if no site administrator exists yet,
# these create one — otherwise nobody can sign in. Both are required together.
# Once an administrator exists these are ignored, so rotating them here will not
# reset a password; change it from the app instead.
LEADMAN_ADMIN_EMAIL=you@example.com
LEADMAN_ADMIN_PASSWORD=choose-something-long

# Optional — name for the account that owns your existing data after upgrading
# from a version without accounts (default "Leadman").
# LEADMAN_ACCOUNT_NAME=Your Firm

# Optional — how long a sign-in lasts, in days (default 30).
# LEADMAN_SESSION_TTL_DAYS=30

# Optional — session cookies are marked Secure in production and not in dev.
# Set to "off" only if you are deliberately serving production over plain HTTP.
# LEADMAN_SECURE_COOKIES=on

# ---------------------------------------------------------------------------

# Optional — a contact string sent as the User-Agent when fetching pages and
# geocoding. OpenStreetMap's usage policy asks for something identifying.
LEADMAN_CONTACT=you@example.com

# Optional — port for the local web UI (default 8787)
PORT=8787

# Optional — set to "off" to boot the UI without any background AI work.
# Useful when you want to browse results without spending anything.
LEADMAN_SCHEDULER=on

# Optional — where the SQLite file lives (default ./data/leadman.db)
# LEADMAN_DB=/Users/you/Documents/leadman.db
