# Copy to .env and fill in.

# One of these is required, matching the model you select in Settings.
# Claude models (claude-*) — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
# OpenAI models (gpt-*, o*) — https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...

# Optional — a contact string sent as the User-Agent when fetching pages and
# geocoding. OpenStreetMap's usage policy asks for something identifying.
LEADMAN_CONTACT=you@example.com

# Optional — port for the local web UI (default 8787)
PORT=8787

# Optional — set to "off" to boot the UI without any background AI work.
# Useful when you want to browse results without spending anything.
LEADMAN_SCHEDULER=on

# Optional — where the SQLite file lives (default ./data/leadman.db)
# LEADMAN_DB=/Users/you/Documents/leadman.db
