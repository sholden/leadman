# Keep the build context small and, more importantly, keep secrets and local
# state out of the image entirely.

.git/
.gitignore
.github/

# Credentials. These arrive as environment variables at run time via Kamal.
.env
.env.*
!.env.example
.kamal/

# Local database and archived documents — production uses a mounted volume.
data/

# Built locally; the image builds its own so a stale local bundle can't ship.
dist/
node_modules/

# Tests and tooling are not needed at run time.
tests/
vitest.config.ts

# Editor and OS noise.
.idea/
.vscode/
*.iml
.DS_Store
*.log
identifier.sqlite

# Docs don't belong in the image.
README.md
